<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.wideawake.ios</string>
    <key>CFBundleName</key>
    <string>Wide Awake</string>
    <key>CFBundleDisplayName</key>
    <string>Wide Awake</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>processing</string>
        <string>fetch</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>Wide Awake requires camera access to scan your target barcode/QR anchor (e.g., bathroom sink or coffee maker) to verify you are physically out of bed.</string>
    <key>NSMotionUsageDescription</key>
    <string>Wide Awake uses motion sensors to detect dynamic body movement and shake challenges to guarantee physical alertness.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Wide Awake monitors real-time steps and heart rate to ensure physical waking thresholds are satisfied before silencing the alarm.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Wide Awake tracks wake-up workout sessions on Apple Watch to verify physical exertion.</string>
</dict>
</plist>
